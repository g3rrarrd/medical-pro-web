---
---

<footer class="bg-primary text-gray-300 py-16">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
			<!-- Col 1: Logo & About -->
			<div class="space-y-6">
				<a href="/" class="flex items-center gap-2">
					<img src="/logo.svg" alt="Medical Pro Logo" class="h-12 w-auto brightness-0 invert" onerror="this.src='https://via.placeholder.com/150x50?text=Medical+Pro'" />
				</a>
				<p class="text-sm leading-relaxed opacity-70">
					Líderes en cuidado médico avanzado, comprometidos con la salud y el bienestar de nuestra comunidad a través de la excelencia clínica.
				</p>
				<div class="flex gap-4">
					<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-all duration-300 group hover:scale-110">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-white"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v-3a5 5 0 0 0-5-5H2v18h3a5 5 0 0 0 5-5v3h6v-3a5 5 0 0 0 5-5h3V2z"/></svg>
					</a>
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-all duration-300 group hover:scale-110">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-white"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37C16 9.53 15.3 7.87 14.1 6.63"/><path d="M4 13h3"/><path d="M15 13h3"/><path d="M12 13v6"/><path d="M12 13l3-3"/><path d="M12 13l-3-3"/></svg>
					</a>
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-all duration-300 group hover:scale-110">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-white"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="4" x="2" y="2" rx="1"/><circle cx="12" cy="5" r="3"/></svg>
					</a>
				</div>
			</div>

			<!-- Col 2: Quick Links -->
			<div>
				<h4 class="text-white font-bold text-lg mb-6">Enlaces Rápidos</h4>
				<ul class="space-y-4">
					<li><a href="/" class="hover:text-secondary transition-colors">Inicio</a></li>
					<li><a href="#servicios" class="hover:text-secondary transition-colors">Servicios</a></li>
					<li><a href="#nosotros" class="hover:text-secondary transition-colors">Nosotros</a></li>
					<li><a href="#cita" class="hover:text-secondary transition-colors">Agendar Cita</a></li>
				</ul>
			</div>

			<!-- Col 3: Contact Info -->
			<div>
				<h4 class="text-white font-bold text-lg mb-6">Contacto</h4>
				<ul class="space-y-4">
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary mt-1"><path d="M20 10c0 6-8 12-8 12s-8-12-8-12a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4z"/><circle cx="12" cy="10" r="3"/></svg>
						<span>Av. Médica 123, Ciudad Salud</span>
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary mt-1"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M2,10h20"/><path d="M10 4v16"/></svg>
						<span>contacto@medicalpro.com</span>
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary mt-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 2 2 0 0 1-1.62-1.1C18.5 21.5 16.5 21 15 21s-3.5.5-4.82 1.1A2 2 0 0 1 7.18 25 2 2 0 0 1 5 23v-3"/><path d="M12 12v8"/><path d="M8 15h8"/><path d="M9 18h6"/></svg>
						<span>+1 (555) 123-4567</span>
					</li>
				</ul>
			</div>

			<!-- Col 4: Newsletter/Brand -->
			<div>
				<h4 class="text-white font-bold text-lg mb-6">Newsletter</h4>
				<p class="text-sm mb-4 opacity-70">Recibe consejos de salud y actualizaciones de nuestra clínica.</p>
				<form class="flex gap-2">
					<input type="email" placeholder="Email" class="bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-secondary w-full" />
					<button class="bg-secondary text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-primary transition-colors">OK</button>
				</form>
			</div>
		</div>

		<div class="pt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6">
			<p class="text-sm opacity-50">&copy; 2026 Medical Pro. Todos los derechos reservados.</p>
			<div class="flex gap-6 text-sm opacity-50">
				<a href="#" class="hover:text-white transition-colors">Política de Privacidad</a>
				<a href="#" class="hover:text-white transition-colors">Términos de Servicio</a>
			</div>
		</div>
	</div>
</footer>
